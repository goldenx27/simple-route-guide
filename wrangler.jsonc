{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simple-route-guide",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PUSH_STORE", "class_name": "PushStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PushStore"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

